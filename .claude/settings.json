{
  "permissions": {
    "allow": [
      "Bash(cargo check*)",
      "Bash(cargo clippy*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/riot.key)",
      "Edit(./.env)",
      "Edit(./data/riot.key)",
      "Write(./.env)",
      "Write(./data/riot.key)"
    ]
  }
}
